{
  "name": "manage-frontend-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "gen:types": "openapi-typescript ../docs/api/openapi.v1.yaml -o src/types/api.gen.ts"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.104.1",
    "@vicons/ionicons5": "^0.13.0",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "md-editor-v3": "^7.1.0",
    "naive-ui": "^2.45.3",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-echarts": "^8.3.1",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tsconfig/node22": "^22.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@10.4.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "vue-demi"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

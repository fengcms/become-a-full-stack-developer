# 构建时环境变量（Next.js 客户端可用的需加 NEXT_PUBLIC_ 前缀）

# 后端 API 基础地址（构建时注入，供 RSC 直连用；浏览器端走同源反代 /api/v1）
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Cloudflare Images 域名（图片优化用，本地开发可留空回退原图）
NEXT_PUBLIC_CF_IMAGE_DOMAIN=

# 站点公开访问地址（SEO/sitemap 用）
NEXT_PUBLIC_SITE_URL=http://localhost:13000

# --- 以下为 wrangler dev / Workers 运行时环境变量，写在 .dev.vars 中 ---
# 反代路由将 /api/v1/* 转发到此后端地址
API_ORIGIN=http://localhost:11000

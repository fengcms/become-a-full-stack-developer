# ── 服务 ──
PORT=3000
NODE_ENV=development

# ── 鉴权 ──
# 访问令牌签名密钥（生产务必更换为强随机值）
JWT_SECRET=change-me

# ── 数据库 ──
# 本地 SQLite 文件路径；:memory: 为内存库（测试默认）
DB_FILE=./data/app.db

# ── 对象存储 ──
# local = 本地磁盘；r2 = Cloudflare R2（需绑定）
STORAGE_DRIVER=local

# ── CORS ──
# 生产填逗号分隔白名单；留空则默认 *
CORS_ORIGINS=*

# ── 种子用户（pnpm seed 创建首个管理员，解决「register 强制 member + 提升需已为 admin」死锁）──
# 全部带默认值，直接 pnpm seed 也能跑出可用 admin；生产务必覆盖密码为强口令。
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123456
SEED_ADMIN_NICKNAME=站点管理员
# 重置已存在管理员的密码/资料：pnpm seed -- --reset
